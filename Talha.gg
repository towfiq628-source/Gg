#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int main() {
    int secretNumber, guess, attempts = 0;

    // Seed the random number generator using current time
    srand(time(0));
    secretNumber = (rand() % 100) + 1; // Generates a number between 1 and 100

    printf("=== Welcome to the Number Guessing Game! ===\n");
    printf("I have chosen a number between 1 and 100.\n");

    // Loop until the user guesses the right number
    do {
        printf("\nEnter your guess: ");
        scanf("%d", &guess);
        attempts++;

        if (guess > secretNumber) {
            printf("Too high! Try a smaller number.\n");
        } else if (guess < secretNumber) {
            printf("Too low! Try a larger number.\n");
        } else {
            printf("\nCongratulations! You guessed it in %d attempts!\n", attempts);
        }
    } while (guess != secretNumber);

    return 0;
}
